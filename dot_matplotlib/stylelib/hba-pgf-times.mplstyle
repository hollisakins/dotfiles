# hba-pgf-times — PGF/LaTeX backend with Times-like font
# Uses the PGF backend with newtxtext + newtxmath (Times text and math).
# Use instead of hba-pgf when the target document uses Times.
#
# Usage:
#   plt.style.use(['hba', 'hba-pgf-times'])

# ── Font ─────────────────────────────────────────────────────────────────────
font.serif              : TeX Gyre Termes

# ── PGF backend ──────────────────────────────────────────────────────────────
pgf.rcfonts             : False
# newtx, not TeX Gyre Termes Math: Termes Math's digits are loosely spaced and its sub/superscripts are
# linear scale-downs (wide, stretched); newtxmath has tight digits and script-size designs (2026-10-13)
pgf.preamble            : \usepackage[T1]{fontenc} \usepackage{newtxtext,newtxmath}

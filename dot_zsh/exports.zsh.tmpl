# Directories
export CODES=$HOME/codes/

# PATH
{{- if eq .chezmoi.os "darwin" }}
export PATH=$HOME/opt/homebrew/bin:$PATH
export PATH=/Library/TeX/texbin:$PATH
export PATH=$HOME/opt/miniforge3/bin:$PATH
export PATH="$HOME/.rbenv/bin:$PATH"
export PATH="$HOME/.rbenv/shims:$PATH"
{{- end }}
export PATH="$PATH:$HOME/.julia/bin:$HOME/.bin"
export PATH="$HOME/.local/bin:$PATH"

# Appearance
export TERM="xterm-256color"
export LSCOLORS="Gxfxxxxxbxegedabagacad"

# Astronomy tools
export SPS_HOME=$CODES/python-fsps/src/fsps/libfsps
export CLOUDY_DATA_PATH=$CODES/cloudy/data
export CLOUDY_EXE=$CODES/cloudy/source/cloudy.exe
export WEBBPSF_PATH=$CODES/webbpsf-data
export CRDS_SERVER_URL=https://jwst-crds.stsci.edu
export CMAKE_MACROS=$CODES/cmake-macros/
export bc03=$CODES/bc03/src/
{{- if hasKey . "campfireRoot" }}
export CAMPFIRE_ROOT={{ .campfireRoot }}
export CRDS_PATH=$CAMPFIRE_ROOT/cache/crds/
{{- end }}

{{ if eq .chezmoi.os "darwin" -}}
# ---- macOS only ----

# Directories
export DRIVE=$HOME/Dropbox/
export RESEARCH=$DRIVE/research/

# Homebrew
export HOMEBREW_NO_ENV_HINTS="true"

# Astronomy tools
export pandeia_refdata="$HOME/Dropbox/data/pandeia/pandeia_data-2026.7-jwst"
export PSF_DIR="$HOME/Dropbox/data/pandeia/pandeia_psfs-2026.7rc1-jwst"
export PYSYN_CDBS='/data/synphot1/grp/redcat/trds/'
export PGPLOT_FONT='/opt/homebrew/share/grfont.dat'

# OpenMPI (local laptop runs; don't set on clusters)
export OMPI_MCA_shmem_mmap_enable_nfs_warning=0
export OMPI_MCA_btl=^sm,vader

# Secrets (1Password)
export CAMPFIRE_SUPABASE_URL="{{ onepasswordRead "op://zsh/campfire_supabase/url" }}"
export CAMPFIRE_SUPABASE_SERVICE_ROLE_KEY="{{ onepasswordRead "op://zsh/campfire_supabase/service_role_key" }}"
export CAMPFIRE_R2_BUCKET_NAME="{{ onepasswordRead "op://zsh/campfire_r2/bucket_name" }}"
export CAMPFIRE_R2_ACCOUNT_ID="{{ onepasswordRead "op://zsh/campfire_r2/account_id" }}"
export CAMPFIRE_R2_ACCESS_KEY_ID="{{ onepasswordRead "op://zsh/campfire_r2/access_key_id" }}"
export CAMPFIRE_R2_SECRET_ACCESS_KEY="{{ onepasswordRead "op://zsh/campfire_r2/secret_access_key" }}"
export CAMPFIRE_S3_OSN_BUCKET_NAME="{{ onepasswordRead "op://zsh/campfire_osn/bucket_name" }}"
export CAMPFIRE_S3_OSN_ENDPOINT="{{ onepasswordRead "op://zsh/campfire_osn/endpoint" | trim }}"
export CAMPFIRE_S3_OSN_ACCESS_KEY_ID="{{ onepasswordRead "op://zsh/campfire_osn/rw_access_key" }}"
export CAMPFIRE_S3_OSN_SECRET_ACCESS_KEY="{{ onepasswordRead "op://zsh/campfire_osn/rw_secret_key" }}"
export CAMPFIRE_S3_OSN_REGION="{{ onepasswordRead "op://zsh/campfire_osn/region" }}"
export CAMPFIRE_S3_OSN_FORCE_PATH_STYLE="{{ onepasswordRead "op://zsh/campfire_osn/force_path_style" }}"
export COMMONPLACE_R2_BUCKET_NAME="{{ onepasswordRead "op://zsh/commonplace_r2/bucket_name" }}"
export COMMONPLACE_R2_ACCOUNT_ID="{{ onepasswordRead "op://zsh/commonplace_r2/account_id" }}"
export COMMONPLACE_R2_ACCESS_KEY_ID="{{ onepasswordRead "op://zsh/commonplace_r2/access_key_id" }}"
export COMMONPLACE_R2_SECRET_ACCESS_KEY="{{ onepasswordRead "op://zsh/commonplace_r2/secret_access_key" }}"
export MAST_API_TOKEN="{{ onepasswordRead "op://zsh/mast_api/credential" }}"
export ADS_DEV_KEY="{{ onepasswordRead "op://zsh/ads_api/credential" }}"
{{- end }}
